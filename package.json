{
  "name": "@mirai-gikai/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:types:gen": "npx --yes supabase gen types typescript --local > packages/supabase/types/supabase.types.ts",
    "db:migrate": "npx supabase migration up --include-all && pnpm run db:types:gen",
    "db:reset": "dotenv -e .env -- npx supabase db reset && pnpm db:types:gen && pnpm seed",
    "dev": "dotenv -e .env -- pnpm -r --stream --parallel run dev",
    "seed": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed",
    "seed:csv": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed:csv",
    "test": "pnpm -r --parallel run test",
    "test:coverage": "pnpm -r --parallel run test:coverage",
    "test:integration": "dotenv -e .env -- vitest run --config tests/supabase/vitest.config.mts && dotenv -e .env -- vitest run --config tests/mcp/vitest.config.mts && pnpm -r run test:integration",
    "test:integration:watch": "dotenv -e .env -- vitest --config tests/supabase/vitest.config.mts",
    "test:integration:coverage": "dotenv -e .env -- vitest run --config tests/supabase/vitest.config.mts && dotenv -e .env -- vitest run --config tests/mcp/vitest.config.mts && pnpm -r run test:integration:coverage",
    "build": "dotenv -e .env -- pnpm -r run build",
    "budget:build-all": "pnpm --filter @mirai-gikai/budget-data build:all",
    "budget:items": "pnpm --filter @mirai-gikai/budget-data build:items",
    "budget:manifest": "pnpm --filter @mirai-gikai/budget-data build:manifest",
    "budget:public": "pnpm --filter @mirai-gikai/budget-data build:public",
    "budget:public:manifest": "pnpm --filter @mirai-gikai/budget-data build:public-manifest",
    "budget:public:program-identities": "pnpm --filter @mirai-gikai/budget-data build:public-program-identities",
    "budget:pdf-sections": "pnpm --filter @mirai-gikai/budget-data extract:pdf-sections",
    "budget:pdf-sections:extended": "pnpm --filter @mirai-gikai/budget-data extract:pdf-sections:extended",
    "budget:pdf-sections:sample": "pnpm --filter @mirai-gikai/budget-data extract:pdf-sections:sample",
    "budget:pdf-sections:special": "pnpm --filter @mirai-gikai/budget-data extract:pdf-sections:special",
    "budget:pdf-sections:special-sample": "pnpm --filter @mirai-gikai/budget-data extract:pdf-sections:special-sample",
    "budget:programs": "pnpm --filter @mirai-gikai/budget-data build:programs",
    "budget:revenue:details": "pnpm --filter @mirai-gikai/budget-data build:revenue-details",
    "budget:revenue:items": "pnpm --filter @mirai-gikai/budget-data build:revenue-items",
    "budget:revenue:allocations:extended-sample": "pnpm --filter @mirai-gikai/budget-data extract:pdf-revenue-allocations:extended-sample",
    "budget:revenue:allocations:link": "pnpm --filter @mirai-gikai/budget-data build:revenue-allocation-links",
    "budget:revenue:allocations:match-source": "pnpm --filter @mirai-gikai/budget-data build:revenue-allocation-source-matches",
    "budget:revenue:allocations:raw": "pnpm --filter @mirai-gikai/budget-data extract:pdf-revenue-allocations",
    "budget:revenue:allocations:sample": "pnpm --filter @mirai-gikai/budget-data extract:pdf-revenue-allocations:sample",
    "budget:revenue:allocations:validate": "pnpm --filter @mirai-gikai/budget-data validate:revenue-allocations",
    "budget:revenue:build-all": "pnpm --filter @mirai-gikai/budget-data build:revenue-all",
    "budget:revenue:match-allocation-sources": "pnpm --filter @mirai-gikai/budget-data build:revenue-allocation-source-matches",
    "budget:revenue:allocations": "pnpm --filter @mirai-gikai/budget-data build:revenue-allocation-links",
    "budget:revenue:profile": "pnpm --filter @mirai-gikai/budget-data profile:revenue-input",
    "budget:revenue:public": "pnpm --filter @mirai-gikai/budget-data build:public-revenue",
    "budget:revenue:raw-allocations": "pnpm --filter @mirai-gikai/budget-data extract:pdf-revenue-allocations",
    "budget:revenue:sections": "pnpm --filter @mirai-gikai/budget-data build:revenue-sections",
    "budget:revenue:validate": "pnpm --filter @mirai-gikai/budget-data validate:revenue",
    "budget:revenue:validate-allocations": "pnpm --filter @mirai-gikai/budget-data validate:revenue-allocations",
    "budget:raw-sections:general": "pnpm --filter @mirai-gikai/budget-data build:raw-sections:general",
    "budget:raw-sections:special": "pnpm --filter @mirai-gikai/budget-data build:raw-sections:special",
    "budget:sections": "pnpm --filter @mirai-gikai/budget-data build:sections",
    "budget:setup": "pnpm --filter @mirai-gikai/budget-data setup:pdf",
    "budget:validate": "pnpm --filter @mirai-gikai/budget-data validate:all",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome format . && biome lint .",
    "lint:fix": "biome format --write . && biome lint --write .",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@supabase/supabase-js": "^2.49.4",
    "dotenv-cli": "^7.4.2",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "pnpm run lint:fix"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
