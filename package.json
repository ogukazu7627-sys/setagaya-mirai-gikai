{
  "name": "@mirai-gikai/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:types:gen": "npx --yes supabase gen types typescript --local > packages/supabase/types/supabase.types.ts",
    "db:migrate": "npx supabase migration up --include-all && pnpm run db:types:gen",
    "db:reset": "dotenv -e .env -- npx supabase db reset && pnpm db:types:gen && pnpm seed",
    "budget:web:import": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed budget:web:import",
    "budget:web:import:inspect": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed budget:web:import:inspect",
    "budget:web:import:verify": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed budget:web:import:verify",
    "budget:web:topics:candidates": "pnpm --filter @mirai-gikai/seed budget:web:topics:candidates",
    "budget:web:topics:curate": "pnpm --filter @mirai-gikai/seed budget:web:topics:curate",
    "budget:web:topics:expand-definitions": "pnpm --filter @mirai-gikai/seed budget:web:topics:expand-definitions",
    "budget:web:topics:publish": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed budget:web:topics:publish",
    "budget:web:topics:review": "pnpm --filter @mirai-gikai/seed budget:web:topics:review",
    "budget:web:topics:report": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed budget:web:topics:report",
    "budget:web:topics:verify": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed budget:web:topics:verify",
    "budget:web:validate": "pnpm --filter @mirai-gikai/seed budget:web:validate",
    "dev": "dotenv -e .env -- pnpm -r --stream --parallel run dev",
    "seed": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed",
    "seed:csv": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed:csv",
    "test": "pnpm -r --parallel run test",
    "test:coverage": "pnpm -r --parallel run test:coverage",
    "test:integration": "dotenv -e .env -- vitest run --config tests/supabase/vitest.config.mts && dotenv -e .env -- vitest run --config tests/mcp/vitest.config.mts && pnpm -r run test:integration",
    "test:integration:watch": "dotenv -e .env -- vitest --config tests/supabase/vitest.config.mts",
    "test:integration:coverage": "dotenv -e .env -- vitest run --config tests/supabase/vitest.config.mts && dotenv -e .env -- vitest run --config tests/mcp/vitest.config.mts && pnpm -r run test:integration:coverage",
    "build": "dotenv -e .env -- pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome format . && biome lint .",
    "lint:fix": "biome format --write . && biome lint --write .",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv-cli": "^7.4.2",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "pnpm run lint:fix"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/propagator-jaeger": "2.10.0",
      "brace-expansion@^2": "2.1.4",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "hono": "4.12.25",
      "ip-address": "10.3.1",
      "lodash-es": "4.18.1",
      "minimatch@^9": "9.0.7",
      "nanoid@^3": "3.3.17",
      "picomatch@^2": "2.3.2",
      "picomatch@^4": "4.0.4",
      "postcss": "8.5.18",
      "protobufjs@^7": "7.6.1",
      "protobufjs@^8": "8.7.2",
      "rollup": "4.59.0",
      "sharp": "0.35.0",
      "tar": "7.5.19",
      "undici": "7.29.0",
      "vite": "7.3.5",
      "ws": "8.21.0"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
