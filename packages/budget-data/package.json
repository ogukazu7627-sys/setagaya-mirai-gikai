{
  "name": "@mirai-gikai/budget-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "tsx src/build-budget-all.ts",
    "build:items": "tsx src/build-budget-items.ts",
    "build:manifest": "tsx src/build-budget-dataset-manifest.ts",
    "build:public": "tsx src/build-public-budget.ts",
    "build:public-program-identities": "tsx src/build-public-budget-program-identities.ts",
    "build:public-revenue": "tsx src/build-public-budget-revenue.ts",
    "build:program-groups": "tsx src/build-budget-program-groups.ts",
    "build:programs": "tsx src/build-budget-programs.ts",
    "build:revenue-all": "tsx src/build-budget-revenue-all.ts",
    "build:revenue-allocation-links": "tsx src/build-budget-revenue-allocation-links.ts",
    "build:revenue-details": "tsx src/build-budget-revenue-details.ts",
    "build:revenue-items": "tsx src/build-budget-revenue-items.ts",
    "build:revenue-allocation-source-matches": "tsx src/build-revenue-allocation-source-matches.ts",
    "build:revenue-allocations": "tsx src/build-budget-revenue-allocation-links.ts",
    "build:revenue-sections": "tsx src/build-budget-revenue-sections.ts",
    "build:raw-sections:general": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_stateful.py",
    "build:raw-sections:special": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_special.py",
    "build:sections": "tsx src/build-budget-sections.ts",
    "extract:pdf-sections": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_stateful.py",
    "extract:pdf-sections:extended": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_extended_sample.py",
    "extract:pdf-sections:sample": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_sample.py",
    "extract:pdf-sections:special": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_special.py",
    "extract:pdf-sections:special-sample": "tsx src/run-budget-python.ts scripts/extract_pdf_sections_special_sample.py",
    "extract:pdf-revenue-allocations": "tsx src/run-budget-python.ts scripts/extract_pdf_revenue_allocations_stateful.py",
    "extract:pdf-revenue-allocations:extended-sample": "tsx src/run-budget-python.ts scripts/extract_pdf_revenue_allocations_extended_sample.py",
    "extract:pdf-revenue-allocations:sample": "tsx src/run-budget-python.ts scripts/extract_pdf_revenue_allocations_sample.py",
    "profile:revenue-input": "tsx src/run-budget-python.ts scripts/profile_budget_revenue_input.py",
    "setup:pdf": "tsx src/setup-budget-python.ts",
    "test": "vitest run",
    "test:pdf-sections": "tsx src/run-budget-python.ts -m unittest discover -s scripts -p 'test_*.py'",
    "test:pdf-sections:regression": "tsx src/run-budget-python.ts -m unittest discover -s scripts -p 'test_extract_pdf_sections_stateful.py'",
    "validate:all": "tsx src/build-budget-validation.ts",
    "validate:revenue": "tsx src/validate-budget-revenue.ts",
    "validate:revenue-allocations": "tsx src/validate-revenue-allocations.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  }
}
